---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BaseLayout from "./BaseLayout.astro";
import Container from "../components/Container.astro";
import { Comment } from "../components/comment/comment.component";

type Props = {
    slug?: string
	title: string
	description?: string
	image?: string
};

const { slug, title, description = "", image } = Astro.props;
const commentApiBaseUrl = import.meta.env.PUBLIC_POMMENT_API_BASE_URL;
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY;
---

<BaseLayout>
	<BaseHead slot="head" title={title} description={description} image={image} />
	<Header />
	<Container defaultPadding={true}>
		<div class="mb-8">
			<article class="text-black dark:text-white">
				<h2 class="text-3xl font-bold leading-normal">{title}</h2>
				<div class="mt-6">
					<slot />
				</div>
			</article>
		</div>

		<slot name="comment">
			{slug ? (
     			<Comment
      				slug={slug}
      				url={Astro.url.href}
      				title={title}
      				apiBaseUrl={commentApiBaseUrl}
      				recaptchaSiteKey={recaptchaSiteKey}
      				client:visible
     			/>
			) : null}
		</slot>
	</Container>
	<Footer />
</BaseLayout>

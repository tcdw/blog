---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION, SITE_AUTHOR_AVATAR } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import { Image } from "astro:assets";
import BackdropBlock from "@/components/BackdropBlock.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import placeholderImage from "@/assets/placeholder.webp";
---

<BaseLayout>
  <BaseHead slot="head" title={SITE_TITLE} description={SITE_DESCRIPTION} />
  <Header hasTitle={false} />
  <Container defaultPadding={false} backdrop={false} mainClass="max-w-5xl">
    <div class="grid grid-cols-2 text-black dark:text-white gap-8">
      <BackdropBlock class={"p-8 space-y-4"}>
        <div class="space-y-6">
          <Image
            src={SITE_AUTHOR_AVATAR}
            width={128}
            densities={[1, 2, 3]}
            alt={"Avatar"}
            class={"rounded-full shadow-xl ring-4 ring-white"}
          />
          <h2 class="text-2xl font-bold">tcdw</h2>
        </div>
        <div class="space-y-1 opacity-70">
          <p>小透明前端（Web/移动端）开发者，是 React Native (Expo) 用户。</p>
          <p>在北京当社畜。</p>
          <p>喜欢观察城市、喜欢工业之美。</p>
          <p>是普通人。</p>
          <p>希望与你交朋友！</p>
        </div>
        <SocialLinks />
      </BackdropBlock>
      <BackdropBlock class={"p-4"}>
        <Image
          src={placeholderImage}
          alt={"placeholder image"}
          class={"aspect-4/3 object-cover"}
          style={"border-radius: 1rem; corner-shape: squircle;"}
        />
      </BackdropBlock>
    </div>
  </Container>
  <Footer />
</BaseLayout>

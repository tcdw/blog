---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION, SITE_AUTHOR_AVATAR } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import { Image, getImage } from "astro:assets";
import { type CollectionEntry, getCollection } from "astro:content";
import BackdropBlock from "@/components/BackdropBlock.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import { Icon } from "astro-icon/components";
import { FactCard } from "@/components/fact-card/fact-card.component";
import { FACTS } from "@/data/facts";
import type { ProcessedFact } from "@/components/fact-card/types";
import { filterPosts } from "@/utils/misc";
import { DEFAULT_OG_IMAGE } from "@/utils/og";
import removeMarkdown from "@/utils/vendors/markdown-to-text";

const processedFacts: ProcessedFact[] = await Promise.all(
  FACTS.map(async fact => {
    const img = await getImage({
      src: fact.image,
      width: 480,
      densities: [1, 2, 3],
    });
    return {
      src: img.src,
      width: img.attributes.width as number,
      height: img.attributes.height as number,
      alt: fact.alt,
      text: fact.text,
      srcSet: img.srcSet?.attribute,
    };
  }),
);

const latestPosts = filterPosts(await getCollection("blog"), {
  filterDraft: true,
  filterUnlisted: true,
}).slice(0, 4);

function getPostExcerpt(post: CollectionEntry<"blog">) {
  const excerpt = removeMarkdown(post.body ?? "");
  return post.data.description || (excerpt.length > 88 ? `${excerpt.slice(0, 88)}...` : excerpt);
}
---

<BaseLayout>
  <BaseHead slot="head" title={SITE_TITLE} description={SITE_DESCRIPTION} image={DEFAULT_OG_IMAGE} />
  <Header hasTitle={false} />
  <Container defaultPadding={false} backdrop={false} mainClass="max-w-6xl">
    <BackdropBlock class={"p-6 md:p-8 space-y-4"}>
      <div class="grid md:grid-cols-2 text-black dark:text-white gap-16">
        <!-- Left Area -->
        <div class="space-y-4">
          <div class="space-y-6">
            <Image
              src={SITE_AUTHOR_AVATAR}
              width={128}
              densities={[1, 2, 3]}
              alt={"Avatar"}
              class={"rounded-full shadow-xl ring-4 ring-white"}
            />
            <h2 class="text-2xl font-bold">tcdw</h2>
          </div>
          <div class="space-y-1 opacity-70">
            <p>小透明前端（Web/移动端）开发者，是 React Native (Expo) 用户。</p>
            <p><s>在北京当社畜。</s>失业中。</p>
            <p>喜欢观察城市、喜欢工业之美。</p>
            <p>是普通人。</p>
            <p>希望与你交朋友！</p>
          </div>
          <SocialLinks />
        </div>
        <!-- Right Area -->
        <div>
          <FactCard client:load facts={processedFacts}>
            <Icon name="ri:dice-line" class={"size-6 opacity-60"} />
          </FactCard>
        </div>
      </div>
    </BackdropBlock>
    <div class={"mt-6 space-y-6 md:space-y-10 p-6 md:p-8"}>
      <div class="flex gap-4 flex-row items-center justify-between">
        <div
          class="space-y-2 text-black dark:text-white relative after:hidden after:w-1/2 after:h-1 after:bg-primary-300 after:dark:bg-white/10 after:md:block after:absolute after:left-0 after:-bottom-4"
        >
          <h2 class="text-2xl font-bold">最近发布</h2>
        </div>
        <a
          href="/blog/"
          class="inline-flex items-center justify-center rounded-full bg-primary-700 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-primary-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600"
        >
          查看更多
        </a>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          latestPosts.map(post => (
            <a href={`/post/${post.id}/`} class="block group" aria-labelledby={`post-${post.id}`}>
              <article class="flex h-full flex-col rounded-3xl border border-black/5 bg-white/70 p-5 text-black transition-colors hover:bg-white dark:border-white/10 dark:bg-white/5 dark:text-white dark:hover:bg-white/10">
                <FormattedDate date={post.data.pubDate} class="text-sm opacity-50" />
                <h3
                  id={`post-${post.id}`}
                  class="mt-2 text-lg md:mt-3 md:text-xl font-semibold leading-snug transition-colors group-hover:text-primary-600 dark:group-hover:text-primary-300"
                >
                  {post.data.title}
                </h3>
                <p class="mt-3 flex-1 text-sm leading-relaxed opacity-75 md:text-base">{getPostExcerpt(post)}</p>
              </article>
            </a>
          ))
        }
      </div>
    </div>
  </Container>
</BaseLayout>
<Footer />

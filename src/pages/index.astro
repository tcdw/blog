---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION, SITE_AUTHOR_AVATAR } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import { Image } from "astro:assets";
import BackdropBlock from "@/components/BackdropBlock.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import placeholderImage from "@/assets/hobbies/hobby_music.jpg";
---

<BaseLayout>
  <BaseHead slot="head" title={SITE_TITLE} description={SITE_DESCRIPTION} />
  <Header hasTitle={false} />
  <Container defaultPadding={false} backdrop={false} mainClass="max-w-5xl">
    <BackdropBlock class={"p-8 space-y-4"}>
      <div class="grid md:grid-cols-2 text-black dark:text-white gap-16">
        <!-- Left Area -->
        <div class="space-y-4">
          <div class="space-y-6">
            <Image
              src={SITE_AUTHOR_AVATAR}
              width={128}
              densities={[1, 2, 3]}
              alt={"Avatar"}
              class={"rounded-full shadow-xl ring-4 ring-white"}
            />
            <h2 class="text-2xl font-bold">tcdw</h2>
          </div>
          <div class="space-y-1 opacity-70">
            <p>小透明前端（Web/移动端）开发者，是 React Native (Expo) 用户。</p>
            <p>在北京当社畜。</p>
            <p>喜欢观察城市、喜欢工业之美。</p>
            <p>是普通人。</p>
            <p>希望与你交朋友！</p>
          </div>
          <SocialLinks />
        </div>
        <!-- Right Area -->
        <div>
          <div class="flex items-center gap-2">
            <h2 class="text-lg font-bold">你不知道的 tcdw</h2>
          </div>
          <div class="relative overflow-hidden rounded-xl bg-white dark:bg-black mt-3">
            <Image
              src={placeholderImage}
              alt={"placeholder"}
              class={"aspect-3/2 object-cover filter grayscale opacity-80"}
              width={480}
              densities={[1, 2, 3]}
            />
          </div>
          <div class="text-sm leading-relaxed opacity-60 mt-2">
            tcdw 偶尔会把游戏 OST 拿来做 16-bit 风格的 Arrangement，已经做了挺多首了。
          </div>
        </div>
      </div>
    </BackdropBlock>
  </Container>
</BaseLayout>
<Footer />
